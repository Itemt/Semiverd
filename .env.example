# Configuración de entorno para Semiverd Backend
# Copia este archivo como .env y rellena con tus datos

# Base de datos PostgreSQL (Descomentar para usar PostgreSQL, por defecto se usa SQLite local)
# DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/semiverd_db

# Seguridad JWT
SECRET_KEY=semiverd-secret-key-cambiame-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ambiente
ENV=development
DEBUG=True
